# ─── Sunway frontend environment ───────────────────────────────────────────
# Copy to `.env.local` for local development. On Vercel, set these in the
# project's Environment Variables instead (Production + Preview scopes) — do NOT
# commit real values. Every var here is NEXT_PUBLIC_* and is baked into the
# client bundle at build time, so it is public by design.
#
# The app always talks to the Go API over REST (the in-app offline mock was
# removed), so the backend must be running and NEXT_PUBLIC_API_URL must point at
# it — there is no fallback in production.

# Base URL of the Go API (must include the /api/v1 suffix).
#   Local dev:   http://localhost:8080/api/v1
#   Production:  https://api.example.uz/api/v1
# In production use a sibling subdomain of the storefront (api.example.uz for
# example.uz) so the httpOnly `sw_refresh` refresh cookie stays first-party.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Display currency (ISO 4217). UZS = Uzbek so'm (minor unit = tiyin).
NEXT_PUBLIC_CURRENCY=UZS

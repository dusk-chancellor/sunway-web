# ─── Sunway frontend environment ───────────────────────────────────────────
# Copy to `.env.local` for local development. The app always talks to the Go
# API over REST (the in-app offline mock was removed), so the backend must be
# running and NEXT_PUBLIC_API_URL must point at it.

# Base URL of the Go API.
# Local dev: http://localhost:8080/api/v1
# Production: https://api.example.uz/api/v1  (a sibling subdomain of the
#   storefront, so the httpOnly refresh cookie stays first-party)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Default locale (en enabled at launch; ru/uz scaffolded)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Currency (ISO 4217). UZS = Uzbek so'm, minor unit = tiyin (100 tiyin = 1 so'm).
NEXT_PUBLIC_CURRENCY=UZS

# Optional: error reporting (left blank in dev)
NEXT_PUBLIC_SENTRY_DSN=

# ─── Sunway frontend environment ───────────────────────────────────────────
# Copy to `.env.local` for local development. Nothing here is secret yet
# because the local API runs inside Next.js (see src/server/*).

# Which build target is active: storefront | admin
APP_TARGET=storefront

# Base URL of the API the typed client talks to.
# Local dev: the built-in Next.js route handlers under /api/v1 (no backend needed).
# Production: point this at the Go backend, e.g. https://api.example.uz/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# Default + enabled locales (en enabled at launch; ru/uz scaffolded)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Currency (ISO 4217). UZS = Uzbek so'm, minor unit = tiyin (100 tiyin = 1 so'm).
NEXT_PUBLIC_CURRENCY=UZS

# Feature flags
NEXT_PUBLIC_FEATURE_DISCOUNTS=false
NEXT_PUBLIC_FEATURE_WISHLIST=true

# Optional: error reporting (left blank in dev)
NEXT_PUBLIC_SENTRY_DSN=
